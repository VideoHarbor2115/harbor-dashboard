# Copy this file to .env.local and fill in your values.

# Your Falix VM server address (shown in the Falix panel)
SERVER_HOST=157.90.205.61
# The Minecraft server port (Java, or Bedrock port if using Geyser)
SERVER_PORT=21046
# Optional: your Falix VM domain (e.g. play.example.falixsrv.com)
# SERVER_DOMAIN=

# Uptime + ping: public URL of the JSON produced by vm/vm-reporter.sh on your VM.
# See vm/README.md for setup.
# VM_STATUS_URL=https://your-server/status.json
