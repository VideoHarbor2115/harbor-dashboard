# Copy this file to .env.local and fill in your values.

# Your Falix VM server address (use domain for best results, e.g., harbormc.falix.dev)
SERVER_HOST=harbormc.falix.dev
# The Minecraft server port (Java port, typically 25565)
SERVER_PORT=25565
# Optional: your Falix VM domain (e.g. play.example.falixsrv.com)
# SERVER_DOMAIN=harbormc.falix.dev

# Uptime + ping: public URL of the JSON produced by vm/vm-reporter.sh on your VM.
# See vm/README.md for setup.
# VM_STATUS_URL=https://your-server/status.json
